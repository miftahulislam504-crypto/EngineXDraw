rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Phase 1: authenticated users only. Cross-service rules that check the
    // matching Firestore project-role (firestore.get()/firestore.exists())
    // can tighten this further — verify exact syntax against current
    // Firebase docs before relying on it, since this varies by rules version.
    match /projects/{projectId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
